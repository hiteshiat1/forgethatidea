# Forge environment — copy to `.env` and fill in. NEVER commit real secrets.
# The server validates these at boot (server/src/env.ts) and fails fast.

# ---- Runtime ----
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Origin of the Vite web app (CORS allow-list).
WEB_ORIGIN=http://localhost:5173

# ---- Anthropic (Epic 0.9) ----
# Required in production. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ---- OpenAI (Epic 0.9b) ----
# Optional. Only needed once the model router (0.9d) routes a task to OpenAI.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---- Gemini (Epic 0.9c) ----
# Optional. Only needed once the model router (0.9d) routes a task to Gemini.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Database (Epic 0.7) ----
# Required in production. Postgres connection string.
DATABASE_URL=postgres://forge:forge@localhost:5432/forge

# ---- Stripe (Epic 6.2) ----
# Optional. Without these, checkout returns a clear checkout_session_failed
# error and the webhook route isn't registered at all — the server still
# boots fine for local dev without real payments configured.
# Get test-mode keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Tier price points (Epic 6.1) ----
# Optional — all default to launch placeholder values (see server/src/env.ts).
PRICE_APP_REFINEMENT_TOPUP_CENTS=
PRICE_SPEC_PACK_CENTS=
PRICE_PITCH_DECK_CENTS=
PRICE_FINANCIAL_PACK_CENTS=
