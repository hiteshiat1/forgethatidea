{
  "name": "@forge/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/standalone.js",
  "scripts": {
    "dev": "tsx watch src/standalone.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/standalone.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.1",
    "@forge/shared": "workspace:*",
    "@google/genai": "^2.17.1",
    "@node-rs/argon2": "^2.2.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.0",
    "openai": "^7.4.0",
    "postgres": "^3.4.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
